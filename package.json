{
  "name": "hb-mabelai",
  "author": "handsbreadth LLC",
  "version": "1.7.0",
  "keywords": ["pebble-app"],
  "private": true,
  "scripts": {
    "gen-env":      "node scripts/gen-env.js",
    "build:prod":   "bash scripts/build.sh prod",
    "build:emu":    "bash scripts/build.sh emulator basalt",
    "build:phone":  "bash scripts/build.sh phone"
  },
  "dependencies": {
    "@rebble/clay": "^1.0.8"
  },
  "pebble": {
    "displayName": "hb MabelAI",
    "uuid": "a1253abf-48bd-4bb1-a9d6-b866b60595e1",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "capabilities": ["microphone", "configurable"],
    "watchapp": {
      "watchface": false,
      "configurable": true
    },
    "messageKeys": {
      "KEY_QUERY":             0,
      "KEY_RESPONSE":          1,
      "KEY_STATUS":            2,
      "KEY_REMINDERS_REQUEST": 3,
      "KEY_REMINDERS_LIST":    4,
      "KEY_TIMERS_REQUEST":    5,
      "KEY_TIMERS_LIST":       6,
      "KEY_ALARMS_REQUEST":    7,
      "KEY_ALARMS_LIST":       8,
      "KEY_WEATHER_REQUEST":   9,
      "KEY_WEATHER_DATA":      10,
      "KEY_TOKENS_REQUEST":    11,
      "KEY_TOKENS_DATA":       12,
      "KEY_ALARM_WAKEUP":      13,
      "KEY_ALARM_LABEL":       14,
      "KEY_ALARM_DISMISSED":   15
    },
    "resources": {
      "media": [
        {
        "menuIcon": true,
        "type": "png",
        "name": "IMAGE_MENU_ICON",
        "file": "images/mabel-head-25x25.png"
      },
      {
        "type": "bitmap",
        "name": "MABEL_DOG_BW",
        "file": "images/mabel-head-80x80-gray.png"
      },
      {
        "type": "bitmap",
        "name": "MABEL_DOG_CLR",
        "file": "images/mabel-head-80x80-clr.png"
      },
      {
        "type": "bitmap",
        "name": "ICON_MIC",
        "file": "images/icon_mic.png"
      },
      {
        "type": "bitmap",
        "name": "ICON_UP",
        "file": "images/icon_up.png"
      },
      {
        "type": "bitmap",
        "name": "ICON_DOWN",
        "file": "images/icon_down.png"
      },
      {
        "type": "bitmap",
        "name": "ICON_HELP",
        "file": "images/icon_help.png"
      },
      {
        "type": "bitmap",
        "name": "ICON_MENU",
        "file": "images/icon_menu.png"
      }
    ]
    }
  }
}
